	partition Fact_OrderItems = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\order_items.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Kept = Table.SelectColumns(Headers, {"order_id", "product_id", "quantity", "unit_price", "discount_percentage", "discount_amount", "gross_sales", "tax_amount", "shipping_cost", "net_sales", "product_cost", "profit"}),
					Typed = Table.TransformColumnTypes(Kept, {{"order_id", type text}, {"product_id", type text}, {"quantity", Int64.Type}, {"unit_price", type number}, {"discount_percentage", type number}, {"discount_amount", type number}, {"gross_sales", type number}, {"tax_amount", type number}, {"shipping_cost", type number}, {"net_sales", type number}, {"product_cost", type number}, {"profit", type number}}, "en-US"),
					Renamed = Table.RenameColumns(Typed, {{"net_sales", "src_net_sales"}, {"profit", "src_profit"}}),
					Indexed = Table.AddIndexColumn(Renamed, "LineID", 1, 1, Int64.Type),
					LineNet = Table.AddColumn(Indexed, "Line Net Sales", each [gross_sales] - [discount_amount], type number),
					LineProfit = Table.AddColumn(LineNet, "Line Profit", each [Line Net Sales] - [product_cost], type number),
					BandSort = Table.AddColumn(LineProfit, "Discount Band Sort", each List.Min({Number.RoundDown([discount_percentage] * 10), 5}), Int64.Type),
					Final = Table.AddColumn(BandSort, "Discount Band", each Text.From([Discount Band Sort] * 10) & "-" & Text.From([Discount Band Sort] * 10 + 10) & "%", type text)
				in
					Final

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

